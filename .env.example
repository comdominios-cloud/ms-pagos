# ---- Aplicacion ----
APP_NAME=ms-pagos
# Puerto DENTRO del contenedor (default de Spring Boot)
APP_PORT=8080
# Puerto publicado en la VM de produccion (rango asignado por el curso: 9000-12000)
PUBLISHED_PORT=9002
SPRING_PROFILES_ACTIVE=dev

# ---- Base de datos MySQL (contenedor en la VM de base de datos) ----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=condominio_pagos
MYSQL_USER=
MYSQL_PASSWORD=

# Cadena JDBC completa (opcional)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/condominio_pagos
